# DeepSeek LLM service（真实 key 放 src/.env，本文件只做模板，勿填真 key）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Local inference services
ASR_BASE_URL=http://127.0.0.1:8000
# vLLM 校验 model 名：必须是 /v1/models 里的完整 id（本机即模型目录路径）
ASR_MODEL=/home/zane/sound/EducationAgent/Qwen3-ASR-0.6B
TTS_BASE_URL=http://127.0.0.1:8001

# HTTP server listen address
SERVER_ADDR=:8080
